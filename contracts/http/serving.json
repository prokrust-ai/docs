{
  "openapi": "3.1.0",
  "info": {
    "title": "Prokrust KServe HTTP API",
    "version": "0.11.0-rc.2",
    "x-release": {
      "component": "serving",
      "tag": "v0.11.0-rc.2",
      "commit": "3428e66a6bc81eaf13ccbe3bee64bd8044a56ce6"
    }
  },
  "tags": [
    {
      "name": "inference",
      "description": "Use INFERENCE_URL for the inference URL made available by your installation, and MODEL_NAME for the model name of the selected endpoint. This is the model server listener. Use the authentication and routing headers required by your serving gateway. The model server validates inference inputs and revision identity; it does not accept the Web session as a serving credential.",
      "x-title": "KServe V2 inference",
      "x-payload-notes": [
        [
          "Decode typed prediction rows",
          "For a predictions tensor with datatype BYTES, parse each data element as a JSON string. entityKey contains type and value for the root (Int64 decimal text or Utf8). observationTimeNs contains the cutoff in decimal nanoseconds or null. prediction.kind selects the shape of prediction.value. regression returns a number. class returns a typed label and class probabilities. labels returns label, score, and rank per item. links returns a typed candidate key, score, and rank per item. forecast returns an array of values in original units. forecastWindows pairs each horizonIndex with startNs and endNs in UTC nanoseconds."
        ],
        [
          "Decode scalar and class tensors",
          "For prediction with datatype FP32, read one regression value per input entity. For prediction with datatype INT64, read one class index per entity. Use the matching row in the probabilities tensor for the class probabilities. Its shape is [batch size, class count]."
        ]
      ]
    }
  ],
  "paths": {
    "/v2": {
      "get": {
        "tags": [
          "inference"
        ],
        "operationId": "serverMetadata",
        "summary": "Read server metadata",
        "description": "Identify the server and supported protocol extension before selecting a model.",
        "responses": {
          "200": {
            "description": "Response from the model server.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ServerMetadata"
                },
                "example": {
                  "name": "prokrust-serving",
                  "version": "0.1.1",
                  "extensions": [
                    "prokrust.kserve-v2/v2"
                  ]
                }
              }
            }
          }
        },
        "x-request-example": "curl --fail \"$INFERENCE_URL/v2\""
      }
    },
    "/v2/health/live": {
      "get": {
        "tags": [
          "inference"
        ],
        "operationId": "serverLive",
        "summary": "Check server liveness",
        "description": "A running HTTP listener responds even while the model is loading.",
        "responses": {
          "200": {
            "description": "Ready for this check. The response body is empty."
          }
        },
        "x-request-example": "curl --fail \"$INFERENCE_URL/v2/health/live\""
      }
    },
    "/v2/health/ready": {
      "get": {
        "tags": [
          "inference"
        ],
        "operationId": "serverReady",
        "summary": "Check server readiness",
        "description": "Check that the server has loaded a usable model.",
        "responses": {
          "200": {
            "description": "Ready for this check. The response body is empty."
          },
          "500": {
            "description": "MODEL_RUNTIME_CORRUPT. Inspect revision and model-server logs.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InferenceError"
                }
              }
            }
          },
          "503": {
            "description": "MODEL_NOT_READY while the runtime loads the model.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InferenceError"
                }
              }
            }
          }
        },
        "x-request-example": "curl --fail \"$INFERENCE_URL/v2/health/ready\""
      }
    },
    "/v2/models/{name}": {
      "get": {
        "tags": [
          "inference"
        ],
        "operationId": "modelMetadata",
        "summary": "Read model metadata",
        "description": "Read the supported input names, datatypes, and output tensors before assembling a batch.",
        "responses": {
          "200": {
            "description": "Response from the model server.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ModelMetadata"
                }
              }
            }
          },
          "400": {
            "description": "INVALID_INFERENCE_REQUEST. The supplied name differs from this endpoint’s configured model name.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InferenceError"
                },
                "example": {
                  "error": "one or more entities are unknown",
                  "code": "UNKNOWN_ENTITY",
                  "request_id": "request-1"
                }
              }
            }
          },
          "500": {
            "description": "MODEL_RUNTIME_CORRUPT. Inspect revision and model-server logs.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InferenceError"
                }
              }
            }
          },
          "503": {
            "description": "MODEL_NOT_READY while the runtime loads the model.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InferenceError"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "required": true,
            "description": "Configured model name on this endpoint. A different name returns HTTP 400.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "x-request-example": "curl --fail \"$INFERENCE_URL/v2/models/$MODEL_NAME\""
      }
    },
    "/v2/models/{name}/ready": {
      "get": {
        "tags": [
          "inference"
        ],
        "operationId": "modelReady",
        "summary": "Check model readiness",
        "description": "Check readiness for the selected model name.",
        "responses": {
          "200": {
            "description": "Ready for this check. The response body is empty."
          },
          "400": {
            "description": "INVALID_INFERENCE_REQUEST. The supplied name differs from this endpoint’s configured model name.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InferenceError"
                },
                "example": {
                  "error": "one or more entities are unknown",
                  "code": "UNKNOWN_ENTITY",
                  "request_id": "request-1"
                }
              }
            }
          },
          "500": {
            "description": "MODEL_RUNTIME_CORRUPT. Inspect revision and model-server logs.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InferenceError"
                }
              }
            }
          },
          "503": {
            "description": "MODEL_NOT_READY while the runtime loads the model.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InferenceError"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "required": true,
            "description": "Configured model name on this endpoint. A different name returns HTTP 400.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "x-request-example": "curl --fail \"$INFERENCE_URL/v2/models/$MODEL_NAME/ready\""
      }
    },
    "/v2/models/{name}/infer": {
      "post": {
        "tags": [
          "inference"
        ],
        "operationId": "infer",
        "summary": "Run inference",
        "description": "Start with model metadata. The example is for a non-temporal model with INT64 entity keys. Replace 42 with an entity present in the loaded graph. For a temporal model append a timestamp_ns input. Predictions use the loaded graph snapshot and its coverage interval. Save the request as request.json.",
        "responses": {
          "200": {
            "description": "Predictions from the selected revision.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InferenceResult"
                }
              }
            }
          },
          "400": {
            "description": "Invalid model, input, or graph cutoff. Check code for INVALID_INFERENCE_REQUEST, UNKNOWN_ENTITY, ROOT_NOT_AVAILABLE, CUTOFF_OUT_OF_RANGE, or FORECAST_HISTORY_UNAVAILABLE.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InferenceError"
                },
                "example": {
                  "error": "one or more entities are unknown",
                  "code": "UNKNOWN_ENTITY",
                  "request_id": "request-1"
                }
              }
            }
          },
          "413": {
            "description": "INFERENCE_LIMIT_EXCEEDED. Reduce the request body (maximum 1 MiB), batch size, or operation size.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InferenceError"
                }
              }
            }
          },
          "429": {
            "description": "INFERENCE_OVERLOADED. The concurrency limit or inference deadline was reached.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InferenceError"
                }
              }
            }
          },
          "500": {
            "description": "MODEL_RUNTIME_CORRUPT. Inspect revision and model-server logs.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InferenceError"
                }
              }
            }
          },
          "503": {
            "description": "MODEL_NOT_READY while loading or INFERENCE_DRAINING while shutting down.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InferenceError"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "required": true,
            "description": "Configured model name on this endpoint. A different name returns HTTP 400.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "X-Request-ID",
            "in": "header",
            "required": false,
            "description": "Optional correlation ID for errors before the body can be validated. A valid body id takes precedence.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/InferenceRequest"
              },
              "example": {
                "id": "request-1",
                "inputs": [
                  {
                    "name": "entity_id",
                    "datatype": "INT64",
                    "shape": [
                      1
                    ],
                    "data": [
                      "42"
                    ]
                  }
                ]
              }
            }
          }
        },
        "x-request-example": "curl --fail -H \"Content-Type: application/json\" --data @request.json \"$INFERENCE_URL/v2/models/$MODEL_NAME/infer\""
      }
    }
  },
  "components": {
    "schemas": {
      "Revision": {
        "type": "object",
        "description": "Identity of the loaded revision.",
        "properties": {
          "model_digest": {
            "type": "string",
            "description": "Digest identifying the loaded model. Compare it with the expected model revision."
          },
          "graph_digest": {
            "type": "string",
            "description": "Digest of the loaded graph snapshot used for this result."
          },
          "contract": {
            "type": "string",
            "description": "Runtime wire contract identifier, prokrust.kserve-v2/v2."
          }
        },
        "required": [
          "model_digest",
          "graph_digest",
          "contract"
        ]
      },
      "TensorMetadata": {
        "type": "object",
        "description": "One input or output advertised by the loaded model.",
        "properties": {
          "name": {
            "type": "string",
            "description": "Tensor name. Match it exactly when building inputs."
          },
          "datatype": {
            "type": "string",
            "description": "Tensor element datatype, for example BYTES or INT64."
          },
          "shape": {
            "type": "array",
            "description": "Tensor dimensions. In metadata a dimension of -1 is the variable batch size.",
            "items": {
              "type": "integer"
            }
          }
        },
        "required": [
          "name",
          "datatype",
          "shape"
        ]
      },
      "InputTensor": {
        "type": "object",
        "description": "A one-dimensional input tensor.",
        "properties": {
          "name": {
            "type": "string",
            "description": "entity_id selects the graph root. timestamp_ns sets the UTC cutoff per root for temporal models.",
            "enum": [
              "entity_id",
              "timestamp_ns"
            ]
          },
          "datatype": {
            "type": "string",
            "description": "Match model metadata for entity_id. timestamp_ns always uses INT64.",
            "enum": [
              "INT64",
              "BYTES"
            ]
          },
          "shape": {
            "type": "array",
            "description": "One positive batch dimension matching the data length. The wire maximum is 1024; the configured batch size can be smaller.",
            "items": {
              "type": "integer",
              "description": "Batch size.",
              "minimum": 1,
              "maximum": 1024
            },
            "minItems": 1,
            "maxItems": 1
          },
          "data": {
            "type": "array",
            "description": "Entity keys or timestamps in request order. For BYTES use UTF-8 strings up to 1024 bytes. For INT64 entity IDs use JSON-safe integers or canonical signed decimal strings. For timestamps use integer nanoseconds UTC or canonical decimal strings.",
            "items": {
              "type": [
                "integer",
                "string"
              ]
            },
            "minItems": 1
          }
        },
        "required": [
          "name",
          "datatype",
          "shape",
          "data"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "name": {
                  "const": "timestamp_ns"
                }
              }
            },
            "then": {
              "properties": {
                "datatype": {
                  "const": "INT64"
                },
                "data": {
                  "items": {
                    "oneOf": [
                      {
                        "type": "integer"
                      },
                      {
                        "type": "string",
                        "pattern": "^(0|-?[1-9][0-9]{0,18})$"
                      }
                    ]
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "name": {
                  "const": "entity_id"
                },
                "datatype": {
                  "const": "INT64"
                }
              }
            },
            "then": {
              "properties": {
                "data": {
                  "items": {
                    "oneOf": [
                      {
                        "type": "integer",
                        "minimum": -9007199254740991,
                        "maximum": 9007199254740991
                      },
                      {
                        "type": "string",
                        "pattern": "^(0|-?[1-9][0-9]{0,18})$"
                      }
                    ]
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "datatype": {
                  "const": "BYTES"
                }
              }
            },
            "then": {
              "properties": {
                "data": {
                  "items": {
                    "type": "string",
                    "maxLength": 1024
                  }
                }
              }
            }
          }
        ]
      },
      "InferenceRequest": {
        "type": "object",
        "description": "JSON inference payload.",
        "properties": {
          "id": {
            "type": "string",
            "description": "Caller-selected correlation ID. Use 1–128 ASCII letters, digits, or - _ . : /. The response echoes it.",
            "pattern": "^[A-Za-z0-9_./:-]{1,128}$"
          },
          "inputs": {
            "type": "array",
            "description": "Ordered input tensors. Send entity_id first. For a temporal model send timestamp_ns second with the same batch size.",
            "items": {
              "$ref": "#/components/schemas/InputTensor"
            },
            "minItems": 1,
            "maxItems": 2
          },
          "parameters": {
            "type": "object",
            "description": "Optional empty object. This version accepts no request parameters.",
            "properties": {},
            "required": [],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "inputs"
        ],
        "additionalProperties": false
      },
      "OutputTensor": {
        "type": "object",
        "description": "One advertised output tensor.",
        "properties": {
          "name": {
            "type": "string",
            "description": "Output name from model metadata: predictions, prediction, or probabilities."
          },
          "datatype": {
            "type": "string",
            "description": "BYTES for JSON-encoded task rows, INT64 for class indexes, or FP32 for floating-point output."
          },
          "shape": {
            "type": "array",
            "description": "Concrete tensor dimensions, with the batch size first.",
            "items": {
              "type": "integer"
            }
          },
          "data": {
            "type": "array",
            "description": "Values in batch order. For probabilities the flat array holds one row of class probabilities per entity. For predictions each string encodes a typed prediction row.",
            "items": {
              "type": [
                "string",
                "number"
              ]
            }
          }
        },
        "required": [
          "name",
          "datatype",
          "shape",
          "data"
        ]
      },
      "InferenceResult": {
        "type": "object",
        "description": "Predictions and revision identity.",
        "properties": {
          "id": {
            "type": "string",
            "description": "Same correlation ID as the request."
          },
          "model_name": {
            "type": "string",
            "description": "Configured name of the served model."
          },
          "model_version": {
            "type": "string",
            "description": "Model format identifier prokrust.model/v2."
          },
          "parameters": {
            "$ref": "#/components/schemas/Revision"
          },
          "outputs": {
            "type": "array",
            "description": "Tensors listed by the model metadata, populated for this batch.",
            "items": {
              "$ref": "#/components/schemas/OutputTensor"
            }
          }
        },
        "required": [
          "id",
          "model_name",
          "model_version",
          "parameters",
          "outputs"
        ]
      },
      "ServerMetadata": {
        "type": "object",
        "description": "Serving runtime identity.",
        "properties": {
          "name": {
            "type": "string",
            "description": "Server implementation, prokrust-serving."
          },
          "version": {
            "type": "string",
            "description": "Build version compiled into the server. This value can differ from the chart release."
          },
          "extensions": {
            "type": "array",
            "description": "Supported extension identifiers. This release advertises prokrust.kserve-v2/v2.",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "name",
          "version",
          "extensions"
        ]
      },
      "ModelMetadata": {
        "type": "object",
        "description": "Wire format of the selected model.",
        "properties": {
          "name": {
            "type": "string",
            "description": "Model name used in this URL."
          },
          "versions": {
            "type": "array",
            "description": "Model artifact format identifiers, including prokrust.model/v2.",
            "items": {
              "type": "string"
            }
          },
          "platform": {
            "type": "string",
            "description": "Runtime platform identifier, prokrust."
          },
          "inputs": {
            "type": "array",
            "description": "Input tensors, in required request order.",
            "items": {
              "$ref": "#/components/schemas/TensorMetadata"
            }
          },
          "outputs": {
            "type": "array",
            "description": "Output tensors produced by this model. Inspect these before decoding predictions.",
            "items": {
              "$ref": "#/components/schemas/TensorMetadata"
            }
          },
          "parameters": {
            "$ref": "#/components/schemas/Revision"
          }
        },
        "required": [
          "name",
          "versions",
          "platform",
          "inputs",
          "outputs",
          "parameters"
        ]
      },
      "InferenceError": {
        "type": "object",
        "description": "Failure returned by the model server.",
        "properties": {
          "error": {
            "type": "string",
            "description": "Readable cause."
          },
          "code": {
            "type": "string",
            "description": "Machine-readable cause such as MODEL_NOT_READY or INVALID_INFERENCE_REQUEST."
          },
          "request_id": {
            "type": "string",
            "description": "Correlation ID for diagnostics. If a request ID is unavailable, the handler uses its operation name or invalid-request."
          }
        },
        "required": [
          "error",
          "code",
          "request_id"
        ]
      }
    }
  }
}
