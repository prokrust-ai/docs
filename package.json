{
  "name": "prokrust-docs",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "refresh:reference": "node scripts/refresh-reference.mjs",
    "refresh:graph": "node scripts/refresh-reference.mjs --resource data.prokrust.ai/v1beta1/Graph",
    "generate": "node scripts/generate-reference.mjs && node scripts/generate-examples.mjs && node scripts/generate-api.mjs && node scripts/generate-http-reference.mjs",
    "check": "node scripts/check-example.mjs && node --test scripts/resource-reference.test.mjs scripts/rpc-reference.test.mjs && node scripts/generate-api.mjs --check && node scripts/generate-http-reference.mjs --check",
    "start": "pnpm generate && docusaurus start",
    "build": "pnpm generate && pnpm check && docusaurus build",
    "serve": "docusaurus serve",
    "refresh:api": "node scripts/refresh-api.mjs",
    "refresh:http": "node scripts/refresh-http.mjs"
  },
  "dependencies": {
    "@docusaurus/core": "3.10.2",
    "@docusaurus/preset-classic": "3.10.2",
    "@easyops-cn/docusaurus-search-local": "^0.55.3",
    "@mdx-js/react": "^3.1.1",
    "ajv": "^8.17.1",
    "prism-react-renderer": "^2.4.1",
    "raw-loader": "^4.0.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "yaml": "^2.8.1"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
